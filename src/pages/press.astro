---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import metadata from '../data/press-metadata.json';
import { press } from '../lib/data';
import { formatDate, parseDate } from '../lib/content';
const details: Record<string, { title: string; publication: string; isHeadline: boolean }> =
  metadata;
const stories = [...press]
  .map((story) => {
    const detail = details[story.url];
    if (!detail) throw new Error(`Missing press metadata: ${story.url}`);
    return { ...story, ...detail };
  })
  .sort(
    (a, b) =>
      parseDate(b.dt).valueOf() - parseDate(a.dt).valueOf() ||
      (a.url < b.url ? -1 : a.url > b.url ? 1 : 0),
  );
---

<BaseLayout
  title="Press"
  description="Media coverage and press about LAION and open machine-learning research."
>
  <PageHero
    eyebrow="In the media"
    title="Press"
    intro="Coverage of LAION, our research, and the wider movement for open AI."
  />
  <div class="shell press-contact">
    <p>
      For media enquiries, contact <a href="mailto:contact@laion.ai?subject=Media%20enquiry"
        >contact@laion.ai</a
      >. Some historical links may require a subscription or no longer be available.
    </p>
  </div>
  <section class="shell press-list" aria-label="Media coverage">
    {
      stories.map((story, index) => (
        <a href={story.url} target="_blank" rel="noopener noreferrer">
          <>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <time datetime={parseDate(story.dt).toISOString()}>{formatDate(story.dt)}</time>
            <div class="story">
              <p class="publication">
                {story.publication}
                {!story.isHeadline && <span> · Archive link</span>}
              </p>
              <h2>{story.title}</h2>
            </div>
            <b aria-hidden="true">↗</b>
          </>
        </a>
      ))
    }
  </section>
</BaseLayout>
<style>
  .press-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    justify-content: space-between;
    padding-block: clamp(2rem, 4vw, 3rem) 1.5rem;
    color: var(--muted);
  }
  .press-contact p {
    max-width: 46rem;
    margin: 0;
  }
  .press-list {
    display: grid;
    gap: 0.5rem;
    padding-block: 1rem clamp(5rem, 9vw, 7rem);
  }
  .press-list a {
    display: grid;
    grid-template-columns: 2.5rem 8.5rem minmax(0, 1fr) 2.5rem;
    gap: 1.25rem;
    align-items: center;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  .press-list a:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }
  span,
  time {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
  .story {
    min-width: 0;
  }
  .publication {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .publication span {
    font-size: inherit;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 900;
    line-height: 1.15;
    text-wrap: balance;
  }
  b {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    justify-self: end;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 400;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .press-list a:hover b {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--night);
  }
  @media (max-width: 700px) {
    .press-list a {
      grid-template-columns: 1fr 2.5rem;
      gap: 0.5rem 1rem;
      padding: 1rem 1.1rem;
    }
    .press-list a > span {
      display: none;
    }
    time {
      grid-column: 1;
      grid-row: 1;
    }
    .story {
      grid-column: 1;
      grid-row: 2;
    }
    b {
      grid-column: 2;
      grid-row: 1 / 3;
    }
  }
</style>
