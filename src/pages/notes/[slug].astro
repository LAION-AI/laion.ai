---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLayout from '../../components/ArticleLayout.astro';
import { excerpt } from '../../lib/content';
export async function getStaticPaths() {
  return (await getCollection('notes')).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props as { post: CollectionEntry<'notes'> };
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={excerpt(post.body ?? '', 157)}
  image={post.data.previewImg}
  type="article"
>
  <ArticleLayout post={post} backHref="/notes" backLabel="Notes"><Content /></ArticleLayout>
</BaseLayout>
