---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DocumentPage from '../components/DocumentPage.astro';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about content');
const { Content } = await render(page);
---

<BaseLayout
  title="About"
  description="Learn about LAION, our open research mission, and our non-profit organization."
>
  <DocumentPage
    title="About"
    intro="A non-profit research network making large-scale machine-learning resources available to the public."
    ><Content /></DocumentPage
  >
</BaseLayout>
