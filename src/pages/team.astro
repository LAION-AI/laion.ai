---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { team } from '../data/team';
---

<BaseLayout
  title="Team"
  description="Meet the community behind LAION's open machine-learning research."
>
  <PageHero
    eyebrow="The network"
    title="Team"
    intro="Researchers, engineers, organizers, and contributors working to keep large-scale AI research open."
  />
  <section class="shell team-grid">
    {
      team.map((member) => (
        <article>
          <div class="portrait">
            <img
              src={`/images/team/${member.img ?? 'none'}.jpg`}
              alt={member.name}
              width="224"
              height="224"
              loading="lazy"
            />
          </div>
          <div class="member">
            <>
              <h2>{member.name}</h2>
              <p class="role">{member.title}</p>
              <p class="bio">{member.desc}</p>
              {member.profile && (
                <a
                  class="profile"
                  href={member.profile}
                  aria-label={`Research profile: ${member.name}`}
                >
                  Research profile <span aria-hidden="true">↗</span>
                </a>
              )}
            </>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(5rem, 9vw, 7rem);
  }
  article {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.25s ease,
      box-shadow 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }
  article:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .portrait {
    overflow: hidden;
    width: 7rem;
    height: 7rem;
    border-radius: 1.25rem;
    background: var(--mist);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.02);
    transition: filter 0.35s ease;
  }
  article:hover .portrait img {
    filter: none;
  }
  .member {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 1.4rem;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 2.4vw, 1.95rem);
    font-weight: 900;
    line-height: 1;
  }
  .role {
    margin: 0.55rem 0 0;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .bio {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .profile {
    display: inline-flex;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 1.25rem;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .profile:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 1000px) {
    .team-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
