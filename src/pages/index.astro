---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkVisual from '../components/WorkVisual.astro';
import { projects } from '../data/projects';
import { team } from '../data/team';
import { excerpt, formatDate, sortPosts } from '../lib/content';

const posts = sortPosts(await getCollection('blog'));
const featured = posts[0];
const [lead, ...recent] = posts.slice(0, 4);
const releaseCount = new Set(projects.flatMap((group) => group.entries.map((entry) => entry.name)))
  .size;

const stats = [
  { value: '5.5B', label: 'image–text pairs in Re-LAION-5B' },
  { value: '10M', label: 'hours of video in LAION-BVD' },
  { value: String(releaseCount), label: 'datasets, models, tools, and papers' },
  { value: String(team.length), label: 'people on the core team' },
];

// Community-generated image grids from the original LAION landing page.
const gallery = [
  { name: 'river', caption: 'a small cabin by a lake, oil painting', ratio: '1034 / 776' },
  { name: 'fox', caption: 'a watercolor fox, blue ink', ratio: '1034 / 776' },
  { name: 'dragon', caption: 'a dragon, charcoal sketch', ratio: '1 / 1' },
  { name: 'painting', caption: 'people in a park, impressionist painting', ratio: '1034 / 776' },
];
const columns = [
  [gallery[0], gallery[1]],
  [gallery[2], gallery[3]],
];

const work = [
  {
    title: 'LAION-BVD',
    kind: 'Dataset · Video',
    text: 'A 10-million-hour open video dataset for research on video-language, audio-language, and image–text models.',
    href: '/blog/bvd',
    visual: 'video',
    layout: 'wide dark',
  },
  {
    title: 'Re-LAION-5B',
    kind: 'Dataset · Image–text',
    text: 'The updated LAION-5B: 5.5 billion text–image-link pairs with additional safety fixes.',
    href: '/blog/relaion-5b',
    visual: 'dataset',
    layout: 'narrow',
  },
  {
    title: 'OpenCLIP',
    kind: 'Model',
    text: 'Large-scale open implementations and models for contrastive language–image training.',
    href: '/blog/large-openclip',
    visual: 'model',
    layout: 'third',
  },
  {
    title: 'Open-sci-ref',
    kind: 'Research',
    text: 'Open language-model baselines and intermediate checkpoints for comparing training datasets.',
    href: '/blog/open-sci-ref-001',
    visual: 'research',
    layout: 'third',
  },
  {
    title: 'BUD-E',
    kind: 'Education',
    text: 'An open conversational AI assistant designed to make education more accessible.',
    href: '/blog/bud-e-release',
    visual: 'speech',
    layout: 'third',
  },
] as const;

const principles = [
  {
    title: 'Open datasets',
    text: 'Large-scale multimodal datasets, each released with documentation of its access conditions and intended uses.',
  },
  {
    title: 'Open models and code',
    text: 'Weights, training code, and evaluation tools published alongside results, so experiments can be reproduced and compared.',
  },
  {
    title: 'A global community',
    text: 'Researchers, engineers, and contributors from around the world, collaborating in the open.',
  },
];
---

<BaseLayout>
  <section class="hero surface-dark">
    <div class="shell hero-grid">
      <div class="hero-copy">
        {
          featured && (
            <a class="announce" href={`/blog/${featured.id}`}>
              <span class="announce-badge">Latest</span>
              <span class="announce-text">{featured.data.title}</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
        <h1>Open AI research should belong to <em>everyone.</em></h1>
        <p class="intro">
          LAION is a non-profit research network building open datasets, models, and tools for
          reproducible machine-learning research and public education.
        </p>
        <div class="actions">
          <a class="button accent" href="/projects"
            >Explore our work <span class="arrow" aria-hidden="true">→</span></a
          >
          <a class="button ghost" href="/about">About LAION</a>
        </div>
      </div>
      <div class="mosaic" aria-hidden="true">
        {
          columns.map((column, columnIndex) => (
            <div class:list={['mosaic-col', columnIndex ? 'drift-down' : 'drift-up']}>
              {/* Three identical sets: the loop shifts by exactly one set. */}
              {[0, 1, 2].map(() => (
                <div class="mosaic-set">
                  {column.map((image) => (
                    <figure style={`aspect-ratio:${image.ratio}`}>
                      <picture>
                        <source srcset={`/images/gallery/${image.name}.avif`} type="image/avif" />
                        <source srcset={`/images/gallery/${image.name}.webp`} type="image/webp" />
                        <img
                          src={`/images/gallery/${image.name}.jpg`}
                          alt=""
                          width="1034"
                          height="776"
                          decoding="async"
                        />
                      </picture>
                      <figcaption>
                        <span>txt</span>“{image.caption}”
                      </figcaption>
                    </figure>
                  ))}
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="shell">
      <dl class="stats">
        {
          stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="campaign shell" aria-labelledby="campaign-heading">
    <div class="campaign-card">
      <div>
        <p class="eyebrow">Donate</p>
        <h2 id="campaign-heading">Open foundation models for science.</h2>
        <p>
          Help us build open pipelines for mathematics and physics, biology, and multimodal world
          models, and power two lighthouse projects: Modelympics and Project Alexandria.
        </p>
      </div>
      <div class="campaign-actions">
        <a class="button accent" href="/donations"
          >Support the campaign <span class="arrow" aria-hidden="true">→</span></a
        >
        <span>Give funds, compute, or storage</span>
      </div>
    </div>
  </section>

  <section class="work shell" aria-labelledby="work-heading">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">What we build</p>
        <h2 class="heading" id="work-heading">Public infrastructure for open AI.</h2>
        <p>
          Datasets, models, and tools released in the open, so anyone can inspect, reproduce, and
          build on them.
        </p>
      </div>
      <a class="arrow-link" href="/projects"
        >View all projects <span class="arrow" aria-hidden="true">→</span></a
      >
    </div>
    <div class="bento">
      {
        work.map((item) => (
          <a class:list={['tile', 'reveal', item.layout]} href={item.href}>
            <div class="tile-visual">
              <WorkVisual kind={item.visual} />
            </div>
            <div class="tile-body">
              <span class="chip">{item.kind}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
            <span class="tile-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="principles" aria-labelledby="principles-heading">
    <div class="shell principles-grid">
      <div class="principles-intro reveal">
        <p class="eyebrow">Why open</p>
        <h2 class="heading" id="principles-heading">Knowledge grows when it is shared.</h2>
        <p>
          LAION exists to broaden access to large-scale machine-learning research. We make reusable
          resources public so more people can inspect, improve, and learn from them.
        </p>
        <div class="principles-actions">
          <a class="button" href="/about">About LAION</a>
          <a class="button secondary" href="/donations">Support our work</a>
        </div>
      </div>
      <ol class="principles-list">
        {
          principles.map((principle, index) => (
            <li class="reveal">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="latest shell" aria-labelledby="latest-heading">
    <div class="section-head reveal">
      <div>
        <p class="eyebrow">From the network</p>
        <h2 class="heading" id="latest-heading">Latest from LAION.</h2>
      </div>
      <a class="arrow-link" href="/blog"
        >Read the blog <span class="arrow" aria-hidden="true">→</span></a
      >
    </div>
    <div class="news">
      {
        lead && (
          <article class="lead-story reveal">
            <a
              class="lead-image"
              href={`/blog/${lead.id}`}
              tabindex="-1"
              aria-hidden="true"
              style={`--preview: url("${lead.data.previewImg}")`}
            >
              <img src={lead.data.previewImg} alt="" width="960" height="540" loading="lazy" />
            </a>
            <div class="lead-body">
              <p class="meta">
                <time datetime={new Date(lead.data.date).toISOString()}>
                  {formatDate(lead.data.date)}
                </time>
              </p>
              <h3>
                <a href={`/blog/${lead.id}`}>{lead.data.title}</a>
              </h3>
              <p>{excerpt(lead.body ?? '', 200)}</p>
            </div>
          </article>
        )
      }
      <ol class="story-list">
        {
          recent.map((post) => (
            <li class="reveal">
              <article>
                <a class="thumb" href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
                  <img src={post.data.previewImg} alt="" width="240" height="160" loading="lazy" />
                </a>
                <div>
                  <p class="meta">
                    <time datetime={new Date(post.data.date).toISOString()}>
                      {formatDate(post.data.date)}
                    </time>
                  </p>
                  <h3>
                    <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  </h3>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }
  .announce {
    display: inline-flex;
    gap: 0.7rem;
    align-items: center;
    max-width: 100%;
    margin-bottom: 2rem;
    padding: 0.3rem 0.9rem 0.3rem 0.3rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--on-dark);
    font-size: 0.92rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .announce:hover {
    border-color: rgba(245, 200, 76, 0.5);
    background: rgba(245, 200, 76, 0.06);
  }
  .announce-badge {
    flex: none;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--night);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .announce-text {
    overflow: hidden;
    min-width: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .announce .arrow {
    flex: none;
    color: var(--accent);
    transition: transform 0.2s var(--ease-out);
  }
  .announce:hover .arrow {
    transform: translateX(3px);
  }
  h1 {
    max-width: 14ch;
    margin: 0;
    color: white;
    font-size: clamp(3.4rem, 7vw, 6.6rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 0.88;
    text-wrap: balance;
    animation: rise 0.9s var(--ease-out) both;
  }
  h1 em {
    background: linear-gradient(100deg, var(--accent) 10%, #ffe7a3 55%, var(--accent) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: normal;
  }
  .intro {
    max-width: 34rem;
    margin: 1.75rem 0 0;
    color: var(--on-dark-muted);
    font-size: clamp(1.12rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    animation: rise 0.9s 0.08s var(--ease-out) both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
    animation: rise 0.9s 0.16s var(--ease-out) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    height: clamp(28rem, 46vw, 38rem);
    overflow: hidden;
    mask-image: linear-gradient(180deg, transparent, #000 14%, #000 86%, transparent);
    animation: fade 1.2s 0.2s ease both;
  }
  .mosaic-col {
    --gap: 1rem;
    animation: drift 70s linear infinite;
  }
  .mosaic-set {
    display: grid;
    gap: var(--gap);
    padding-bottom: var(--gap);
  }
  .drift-down {
    margin-top: -6rem;
    animation-direction: reverse;
    animation-duration: 80s;
  }
  .mosaic figure {
    position: relative;
    overflow: hidden;
    margin: 0;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background: var(--night-2);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }
  .mosaic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mosaic figcaption {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-sm);
    background: rgba(6, 18, 32, 0.72);
    color: #dbe6ee;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.3;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .mosaic figcaption span {
    flex: none;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: rgba(245, 200, 76, 0.16);
    color: var(--accent);
    text-transform: uppercase;
  }
  @keyframes drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-100% / 3));
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    border-top: 1px solid var(--line-dark);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 1.75rem 1.5rem 2.5rem 0;
  }
  .stats div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line-dark);
  }
  .stats dd {
    margin: 0;
    color: white;
    font-size: clamp(2.6rem, 4.5vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .stats dt {
    max-width: 14rem;
    margin-top: 0.6rem;
    color: var(--on-dark-muted);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  /* Campaign */
  .campaign {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .campaign-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 3rem;
    align-items: center;
    padding: clamp(1.6rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .campaign-card h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3.5vw, 2.75rem);
    font-weight: 900;
    line-height: 1;
    text-wrap: balance;
  }
  .campaign-card p:not(.eyebrow) {
    max-width: 40rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
  }
  .campaign-actions {
    display: grid;
    gap: 0.6rem;
    justify-items: center;
  }
  .campaign-actions span {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Work */
  .work {
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  .campaign + .work {
    padding-top: clamp(4rem, 8vw, 6rem);
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 26rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s ease;
  }
  .tile:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }
  .tile.wide {
    grid-column: span 4;
  }
  .tile.narrow {
    grid-column: span 2;
  }
  .tile.third {
    grid-column: span 2;
  }
  .tile.dark {
    border-color: transparent;
    background:
      radial-gradient(40rem 20rem at 85% 0%, rgba(106, 168, 255, 0.22), transparent 70%),
      var(--night);
    color: white;
  }
  .tile-visual {
    flex: 1;
    display: grid;
    align-items: center;
    padding: 2rem 2rem 0;
    color: var(--sky);
    transition: transform 0.5s var(--ease-out);
  }
  .tile:hover .tile-visual {
    transform: scale(1.025);
  }
  .tile.dark .tile-visual {
    color: #9cc3ff;
  }
  .tile.wide .tile-visual {
    padding-inline: 2.5rem 30%;
  }
  .tile-body {
    padding: 1.75rem 2rem 2rem;
  }
  .tile.dark .chip {
    border-color: var(--line-dark);
    background: rgba(255, 255, 255, 0.06);
    color: var(--on-dark-muted);
  }
  .tile h3 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(2rem, 3vw, 2.6rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .tile p {
    max-width: 30rem;
    margin: 0;
    color: var(--muted);
  }
  .tile.dark p {
    color: var(--on-dark-muted);
  }
  .tile-arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 1rem;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      transform 0.35s var(--ease-out);
  }
  .tile.dark .tile-arrow {
    border-color: var(--line-dark);
  }
  .tile:hover .tile-arrow {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--night);
    transform: rotate(45deg);
  }

  /* Principles */
  .principles {
    padding-block: clamp(5rem, 10vw, 8rem);
    border-block: 1px solid var(--line);
    background: var(--surface);
  }
  .principles-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
  }
  .principles-intro > p:not(.eyebrow) {
    max-width: 32rem;
    margin: 1.5rem 0 0;
    color: var(--muted);
    font-size: 1.2rem;
  }
  .principles-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.25rem;
  }
  .principles-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .principles-list li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }
  .principles-list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .principles-list span {
    grid-row: span 2;
    padding-top: 0.45rem;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .principles-list h3 {
    margin: 0;
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    font-weight: 900;
    line-height: 1.05;
  }
  .principles-list p {
    max-width: 30rem;
    margin: 0.6rem 0 0;
    color: var(--muted);
  }

  /* Latest */
  .latest {
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  .news {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .meta {
    margin: 0;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .lead-story {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .lead-image {
    position: relative;
    isolation: isolate;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--mist);
  }
  .lead-image::before {
    position: absolute;
    z-index: -1;
    inset: -2rem;
    background: var(--preview) center / cover;
    filter: blur(28px) saturate(1.15);
    opacity: 0.55;
    content: '';
  }
  .lead-image img,
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .lead-image img {
    object-fit: contain;
  }
  .lead-story:hover .lead-image img,
  .story-list article:hover .thumb img {
    transform: scale(1.04);
  }
  .lead-body {
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }
  .lead-body h3 {
