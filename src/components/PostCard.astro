---
import type { PostEntry } from '../lib/content';
import { excerpt, formatDate, readingTime } from '../lib/content';
interface Props {
  post: PostEntry;
  basePath: string;
  featured?: boolean;
}
const { post, basePath, featured = false } = Astro.props;
const href = `/${basePath}/${post.id}`;
const lang = basePath === 'blog-de' ? 'de' : 'en';
---

<article class:list={['post-card', { featured }]}>
  <a
    class="image-wrap"
    href={href}
    tabindex="-1"
    aria-hidden="true"
    style={featured ? `--preview: url("${post.data.previewImg}")` : undefined}
  >
    <img
      src={post.data.previewImg}
      alt=""
      width="960"
      height="540"
      loading={featured ? 'eager' : 'lazy'}
    />
  </a>
  <div class="card-body">
    <p class="meta">
      <time datetime={new Date(post.data.date).toISOString()}
        >{formatDate(post.data.date, lang === 'de' ? 'de-DE' : 'en-GB')}</time
      ><span aria-hidden="true">·</span><span
        >{readingTime(post.body ?? '')} {lang === 'de' ? 'Min. Lesezeit' : 'min read'}</span
      >
    </p>
    <h2><a href={href}>{post.data.title}</a></h2>
    <p class="excerpt">{excerpt(post.body ?? '', featured ? 260 : 160)}</p>
    <p class="author">{post.data.author}</p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      border-color 0.35s ease;
  }
  .post-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }
  .image-wrap {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--line);
    background: var(--mist);
  }
  .image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .post-card:hover .image-wrap img {
    transform: scale(1.04);
  }
  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    font-weight: 900;
    line-height: 1.05;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  h2 a {
    text-decoration: none;
  }
  /* Make the whole card clickable through the title link. */
  h2 a::after {
    position: absolute;
    inset: 0;
    content: '';
  }
  .excerpt {
    overflow-wrap: anywhere;
    margin: 0.85rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.55;
  }
  .author {
    display: -webkit-box;
    overflow: hidden;
    margin: auto 0 0;
    padding-top: 1rem;
    width: 100%;
    border-top: 1px solid var(--line);
    color: var(--subtle);
    font-size: 0.88rem;
    line-height: 1.4;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .featured {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
  }
  .featured .image-wrap {
    position: relative;
    isolation: isolate;
    aspect-ratio: auto;
    min-height: 26rem;
    border-right: 1px solid var(--line);
    border-bottom: 0;
  }
  /* Show the whole preview over a blurred fill, whatever its aspect ratio. */
  .featured .image-wrap::before {
    position: absolute;
    z-index: -1;
    inset: -2rem;
    background: var(--preview) center / cover;
    filter: blur(28px) saturate(1.15);
    opacity: 0.55;
    content: '';
  }
  .featured .image-wrap img {
    object-fit: contain;
  }
  .featured .card-body {
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .featured h2 {
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 0.98;
  }
  .featured .excerpt {
    font-size: 1.05rem;
  }
  @media (max-width: 760px) {
    .featured {
      display: flex;
    }
    .featured .image-wrap {
      min-height: 0;
      aspect-ratio: 16 / 9;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
