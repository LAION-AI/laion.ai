---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const primary = [
  ['Projects', '/projects'],
  ['Team', '/team'],
  ['Blog', '/blog'],
  ['Notes', '/notes'],
  ['About', '/about'],
] as const;
const secondary = [
  ['Press', '/press'],
  ['FAQ', '/faq'],
  ['Donations', '/donations'],
  ['Dataset requests', '/dataset-requests'],
  ['Privacy', '/privacy-policy'],
  ['Impressum', '/impressum'],
  ['GEP policy', '/gep-policy'],
] as const;
const active = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="LAION home">
      <span>LAION</span><img src="/images/logo.svg" alt="" width="38" height="38" />
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {
        primary.map(([label, href]) => (
          <a href={href} aria-current={active(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <details class="more">
        <summary>More <span aria-hidden="true">+</span></summary>
        <div class="more-menu">
          {
            secondary.map(([label, href]) => (
              <a href={href} aria-current={active(href) ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </details>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Open navigation">
        <span class="menu-word">Menu</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </summary>
      <nav aria-label="Mobile navigation">
        {
          [...primary, ...secondary].map(([label, href]) => (
            <a href={href} aria-current={active(href) ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
        <div class="socials">
          <a href="mailto:contact@laion.ai">Email</a>
          <a href="https://discord.com/invite/eq3cAMZtCC">Discord</a>
          <a href="https://github.com/LAION-AI/">GitHub</a>
        </div>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: rgba(246, 246, 246, 0.94);
    backdrop-filter: blur(16px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5rem;
  }
  .brand {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--ink);
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 1;
    text-decoration: none;
  }
  .brand img {
    width: 2rem;
    height: 2rem;
    filter: brightness(0) saturate(100%) invert(13%) sepia(21%) saturate(1576%) hue-rotate(164deg)
      brightness(92%) contrast(93%);
  }
  .desktop-nav {
    display: flex;
    gap: 1.7rem;
    align-items: center;
    font-size: 0.96rem;
    font-weight: 700;
  }
  .desktop-nav > a,
  summary {
    text-decoration: none;
    cursor: pointer;
  }
  .desktop-nav a {
    position: relative;
  }
  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.4rem;
    left: 0;
    height: 2px;
    background: var(--ink);
    content: '';
    transform: scaleX(0);
    transition: transform 0.18s ease;
  }
  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .more {
    position: relative;
  }
  .more summary {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    list-style: none;
  }
  .more summary::-webkit-details-marker,
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .more[open] summary span {
    transform: rotate(45deg);
  }
  .more-menu {
    position: absolute;
    top: 2rem;
    right: 0;
    display: grid;
    min-width: 13rem;
    padding: 0.65rem;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 0 18px 40px rgba(16, 40, 61, 0.14);
  }
  .more-menu a {
    padding: 0.55rem 0.7rem;
    text-decoration: none;
  }
  .more-menu a:hover {
    background: var(--mist);
  }
  .mobile-nav {
    display: none;
  }
  @media (max-width: 820px) {
    .header-inner {
      min-height: 4.25rem;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .mobile-nav > summary {
      display: flex;
      gap: 0.55rem;
      align-items: center;
      width: auto;
      height: 2.5rem;
      list-style: none;
      cursor: pointer;
    }
    .menu-word {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .menu-icon {
      display: grid;
      gap: 0.4rem;
    }
    .mobile-nav > summary i {
      display: block;
      width: 1.25rem;
      height: 2px;
      background: var(--ink);
      transition: transform 0.18s ease;
    }
    .mobile-nav[open] > summary i:first-child {
      transform: translateY(0.2rem) rotate(45deg);
    }
    .mobile-nav[open] > summary i:last-child {
      transform: translateY(-0.2rem) rotate(-45deg);
    }
    .mobile-nav nav {
      position: fixed;
      inset: 4.25rem 0 auto;
      display: grid;
      max-height: calc(100vh - 4.25rem);
      overflow-y: auto;
      padding: 1.2rem max(1rem, calc((100vw - 78rem) / 2));
      border-bottom: 1px solid var(--line);
      background: var(--paper);
      box-shadow: 0 18px 40px rgba(16, 40, 61, 0.12);
    }
    .mobile-nav nav > a {
      padding: 0.65rem 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.25rem;
      font-weight: 700;
      text-decoration: none;
    }
    .socials {
      display: flex;
      gap: 1.1rem;
      padding: 1rem 0 0.25rem;
      font-size: 0.9rem;
    }
  }
</style>
