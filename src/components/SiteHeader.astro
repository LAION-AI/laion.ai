---
interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;
const primary = [
  ['Projects', '/projects'],
  ['Blog', '/blog'],
  ['Team', '/team'],
  ['About', '/about'],
] as const;
const secondary = [
  ['Notes', '/notes'],
  ['Press', '/press'],
  ['FAQ', '/faq'],
  ['Donations', '/donations'],
  ['Dataset requests', '/dataset-requests'],
  ['Privacy', '/privacy-policy'],
  ['Impressum', '/impressum'],
  ['GEP policy', '/gep-policy'],
] as const;
const cta = ['Contribute', '/contribute'] as const;
const active = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
const secondaryActive = secondary.some(([, href]) => active(href));
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="LAION home">
      <img src="/images/logo.svg" alt="" width="28" height="28" /><span>LAION</span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {
        primary.map(([label, href]) => (
          <a href={href} aria-current={active(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
      <details class="more">
        <summary class:list={{ current: secondaryActive }}
          >More <svg aria-hidden="true" viewBox="0 0 12 12" width="10" height="10"
            ><path d="M2 4.5 6 8l4-3.5" fill="none" stroke="currentColor" stroke-width="1.5"
            ></path></svg
          ></summary
        >
        <div class="more-menu">
          {
            secondary.map(([label, href]) => (
              <a href={href} aria-current={active(href) ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </details>
    </nav>
    <div class="header-actions">
      <a class="icon-link" href="https://github.com/LAION-AI/" aria-label="LAION on GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
      <a
        class="button accent header-cta"
        href={cta[1]}
        aria-current={active(cta[1]) ? 'page' : undefined}>{cta[0]}</a
      >
      <details class="mobile-nav">
        <summary aria-label="Navigation menu">
          <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <nav aria-label="Mobile navigation">
          <div class="mobile-primary">
            {
              [...primary, cta].map(([label, href]) => (
                <a href={href} aria-current={active(href) ? 'page' : undefined}>
                  {label}
                  <span aria-hidden="true">→</span>
                </a>
              ))
            }
          </div>
          <div class="mobile-secondary">
            {
              secondary.map(([label, href]) => (
                <a href={href} aria-current={active(href) ? 'page' : undefined}>
                  {label}
                </a>
              ))
            }
          </div>
          <div class="socials">
            <a href="mailto:contact@laion.ai">Email</a>
            <a href="https://discord.com/invite/eq3cAMZtCC">Discord</a>
            <a href="https://github.com/LAION-AI/">GitHub</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--line-dark);
    background: rgba(6, 18, 32, 0.95);
    color: var(--on-dark);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    backdrop-filter: saturate(160%) blur(18px);
  }
  .header-inner {
    display: flex;
    gap: 2rem;
    align-items: center;
    min-height: var(--header-height);
  }
  .brand {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    margin-right: auto;
    color: white;
    font-size: 1.65rem;
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
  }
  .brand img {
    width: 1.75rem;
    height: 1.75rem;
    transition: transform 0.35s var(--ease-out);
  }
  .brand:hover img {
    transform: rotate(-12deg) scale(1.06);
  }
  .desktop-nav {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    font-size: 0.98rem;
  }
  .desktop-nav > a,
  .more summary {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    color: var(--on-dark-muted);
    text-decoration: none;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .desktop-nav > a:hover,
  .more summary:hover,
  .more[open] summary {
    background: rgba(255, 255, 255, 0.07);
    color: white;
  }
  .desktop-nav > a[aria-current='page'],
  .more summary.current {
    color: white;
    background: rgba(255, 255, 255, 0.09);
  }
  .more {
    position: relative;
  }
  .more summary {
    list-style: none;
  }
  .more summary svg {
    transition: transform 0.2s ease;
  }
  .more summary::-webkit-details-marker,
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .more[open] summary svg {
    transform: rotate(180deg);
  }
  .more-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    display: grid;
    min-width: 14rem;
    padding: 0.45rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background: rgba(11, 28, 45, 0.97);
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.55);
    transform: translateX(-50%);
  }
  .more-menu a {
    padding: 0.55rem 0.8rem;
    border-radius: var(--radius-sm);
    color: var(--on-dark-muted);
    text-decoration: none;
  }
  .more-menu a:hover,
  .more-menu a[aria-current='page'] {
    background: rgba(255, 255, 255, 0.07);
    color: white;
  }
  .header-actions {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }
  .icon-link {
    display: inline-grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 999px;
    color: var(--on-dark-muted);
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .icon-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: white;
  }
  .header-cta {
    min-height: 2.5rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.95rem;
  }
  .mobile-nav {
    display: none;
  }
  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .mobile-nav > summary {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      place-items: center;
      border: 1px solid var(--line-dark);
      border-radius: 999px;
      list-style: none;
      cursor: pointer;
    }
    .menu-icon {
      display: grid;
      gap: 0.32rem;
    }
    .mobile-nav > summary i {
      display: block;
      width: 1.1rem;
      height: 1.5px;
      background: white;
      transition: transform 0.2s var(--ease-out);
    }
    .mobile-nav[open] > summary i:first-child {
      transform: translateY(0.2rem) rotate(45deg);
    }
    .mobile-nav[open] > summary i:last-child {
      transform: translateY(-0.2rem) rotate(-45deg);
    }
    .mobile-nav nav {
      position: fixed;
      inset: var(--header-height) 0 auto;
      display: grid;
      gap: 1.5rem;
      max-height: calc(100dvh - var(--header-height));
      overflow-y: auto;
      padding: 1rem max(1rem, calc((100vw - 80rem) / 2)) 2rem;
      border-bottom: 1px solid var(--line-dark);
      background: var(--night);
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
    }
    .mobile-primary {
      display: grid;
    }
    .mobile-primary a {
      display: flex;
      justify-content: space-between;
      padding: 0.85rem 0;
      border-bottom: 1px solid var(--line-dark);
      color: white;
      font-size: 1.6rem;
      font-weight: 900;
      text-decoration: none;
    }
    .mobile-primary a span {
      color: var(--on-dark-muted);
      font-weight: 400;
    }
    .mobile-primary a[aria-current='page'] {
      color: var(--accent);
    }
    .mobile-secondary {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.15rem 1rem;
    }
    .mobile-secondary a {
      padding: 0.45rem 0;
      color: var(--on-dark-muted);
      text-decoration: none;
    }
    .mobile-secondary a[aria-current='page'] {
      color: white;
    }
    .socials {
      display: flex;
      gap: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--line-dark);
      font-family: var(--font-mono);
      font-size: 0.78rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .socials a {
      color: var(--on-dark-muted);
      text-decoration: none;
    }
  }
  @media (max-width: 520px) {
    .icon-link {
      display: none;
    }
  }
</style>
